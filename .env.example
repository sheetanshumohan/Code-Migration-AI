# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Code Migration AI"
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production-min-32-chars-hex-entropy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# Primary Database (Neon Serverless Postgres)
POSTGRES_ASYNC_URI=postgresql+asyncpg://neondb_owner:your-db-password@ep-sample-host.us-east-2.aws.neon.tech/neondb?ssl=require

# Graph Database (Neo4j Aura Free)
NEO4J_URI=neo4j+s://your-database-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-secure-password

# Vector Database (Qdrant Cloud)
QDRANT_HOST=your-cluster-id.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-cloud-jwt-api-key
# Distributed Task Queue & Cache (Upstash Serverless Redis)
REDIS_HOST=your-redis-instance.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-redis-password
CELERY_BROKER_URL=rediss://default:your-upstash-redis-password@your-redis-instance.upstash.io:6379/0?ssl_cert_reqs=CERT_NONE
CELERY_RESULT_BACKEND=rediss://default:your-upstash-redis-password@your-redis-instance.upstash.io:6379/0?ssl_cert_reqs=CERT_NONE

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI & LLM Provider API Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=gsk_your-groq-api-key
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_FRONTIER_MODEL=openai/gpt-oss-120b
DEFAULT_FAST_MODEL=openai/gpt-oss-20b
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

# Observability & Monitoring
ENABLE_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=https://your-sentry-public-key@o000000.ingest.sentry.io/000000000000
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_sample
LANGSMITH_PROJECT=codemigration-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Repository Ingestion Sandboxes
WORKSPACE_DIR=./data/workspace_sandboxes
MAX_REPO_CLONE_SIZE_MB=500
SANDBOX_EXECUTION_TIMEOUT_SECONDS=120

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# GitHub Integration (required for automated PR creation)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Email Configuration (Removed)
